NODE_ENV=production
PORT=8080

# RDS (PostgreSQL) endpoint — from Step 2 of the deploy guide.
DATABASE_URL="postgresql://shannova:REPLACE_ME@<rds-endpoint>:5432/shannova?schema=public"

# ElastiCache (Redis) endpoint — from Step 3 of the deploy guide.
REDIS_URL="redis://<elasticache-endpoint>:6379"

# Meilisearch — runs alongside the api/worker containers on the EC2 host.
MEILI_MASTER_KEY="REPLACE_ME_STRONG_RANDOM_VALUE"

# Must be overridden — apps/api/src/lib/env.ts falls back to a committed
# default if this is unset. Generate with: openssl rand -base64 48
JWT_SECRET="REPLACE_ME_STRONG_RANDOM_VALUE"

# Auth (Clerk)
CLERK_SECRET_KEY="REPLACE_ME"
CLERK_PUBLISHABLE_KEY="REPLACE_ME"

# Email (Gmail SMTP) — do not reuse the default committed in env.ts.
EMAIL_USER="REPLACE_ME@example.com"
EMAIL_PASS="REPLACE_ME_APP_PASSWORD"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Cloudflare R2 (file storage) — optional, only needed if uploads are used.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Judge0 (code execution sandbox) — optional.
JUDGE0_API_URL=""
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# Google Calendar sync — optional.
GOOGLE_CALENDAR_ID=""
GOOGLE_WEBHOOK_SECRET=""
